# Core ports
PORT=1930
DASHBOARD_PORT=1931

# API key (clients send as Authorization: Bearer <key>)
API_KEY=pool-proxy-secret-key

# Database (SQLite)
DATABASE_PATH=./data/poolprox3.db

# Token encryption key (32 hex chars). install.sh / install.ps1 generate one for you.
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# Auth bot (Python + Playwright/Camoufox).
# Defaults below assume the in-tree venv at scripts/auth/.venv created by the installer.
AUTH_SCRIPT_PATH=./scripts/auth/login.py
# Python path — leave empty for auto-detection (recommended).
# The server auto-detects the correct venv path for your OS:
#   Linux/macOS: scripts/auth/.venv/bin/python
#   Windows:     scripts/auth/.venv/Scripts/python.exe
PYTHON_PATH=
AUTH_SCRIPT_CWD=./scripts/auth

# Outbound proxy for the auth bot (optional, e.g. http://user:pass@host:port)
PROXY_URL=

# Browser engine for auth: camoufox (anti-detect, default) | chromium
BROWSER_ENGINE=camoufox
HEADLESS=true

# Captcha solver (optional)
CAPTCHA_SERVICE=none
CAPTCHA_API_KEY=

# Telemetry body storage. Bodies are persisted by default (redacted content)
# for request inspection; set POOLPROX_LOG_BODY_ENABLED=false to store only
# metadata + token counts.
POOLPROX_LOG_BODY_ENABLED=true
# Full bodies only on explicit opt-in (default false).
POOLPROX_LOG_BODY_FULL=false
# Redaction on by default (set false to disable).
POOLPROX_LOG_BODY_REDACT=true
POOLPROX_LOG_BODY_MAX_BYTES=65536

# Bounded request protections (0 = unlimited).
POOLPROX_MAX_BODY_BYTES=10485760
POOLPROX_MAX_STREAM_BYTES=268435456
POOLPROX_MAX_CONCURRENT_REQUESTS=0

# Cache + timeouts (ms).
POOLPROX_ACCOUNT_CACHE_TTL_MS=3000
POOLPROX_AUTH_PROCESS_TIMEOUT_MS=600000
POOLPROX_PROVIDER_REQUEST_TIMEOUT_MS=120000
POOLPROX_PROVIDER_QUOTA_TIMEOUT_MS=15000

# Billing address (JSON) used for provider flows requiring one.
BILLING_ADDRESS={"name":"John Doe","country":"US","line1":"123 Main St","city":"New York","state":"NY","postal_code":"10001"}